# ---------------------------------------------------------------------------
# Azure AI Foundry (required)
# ---------------------------------------------------------------------------
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Deployed model name, e.g. gpt-5, gpt-4.1, o4-mini
FOUNDRY_MODEL=gpt-5
# Optional: a cheaper/faster model for the high-volume scout agents
FOUNDRY_MODEL_FAST=gpt-5-mini

# Auth: "cli" uses `az login` (AzureCliCredential); "default" uses
# DefaultAzureCredential (managed identity, env vars, VS Code, ...).
AZURE_CREDENTIAL_MODE=cli
# Reasoning models (gpt-5, o1, o3, o4) reject `temperature` with a 400. That is
# detected from the model name; set true/false to override. `ppn preflight`
# checks it against the live service in a couple of seconds.
FOUNDRY_TEMPERATURE_SUPPORT=auto

# ---------------------------------------------------------------------------
# WordPress (powerplatformninja.com)
# ---------------------------------------------------------------------------
# Site root, no trailing slash. The REST API lives at <WP_URL>/wp-json/wp/v2
WP_URL=https://powerplatformninja.com
# WordPress username (not the display name)
WP_USERNAME=
# Application Password: WP Admin -> Users -> Profile -> Application Passwords.
# Paste it WITH or WITHOUT spaces, both work.
WP_APP_PASSWORD=
# Status for posts created by the crew. Keep "draft" until you trust it.
WP_DEFAULT_STATUS=draft
# Push to WordPress automatically at the end of a successful pipeline run.
WP_AUTO_PUSH=true
# Verify TLS (set false only for local dev sites)
WP_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# Web search
# ---------------------------------------------------------------------------
# foundry  = Azure AI Foundry's built-in web search tool (GA). No API key, no
#            extra Azure resource — Microsoft manages the Bing resource behind
#            it and the search runs inside the service. This is the default.
# tavily   = call the Tavily API from this process (needs TAVILY_API_KEY)
# brave    = call the Brave Search API from this process (needs BRAVE_API_KEY)
# none     = no open-web search; RSS feeds + Microsoft Learn only
SEARCH_PROVIDER=foundry

# Only used when SEARCH_PROVIDER=foundry
SEARCH_CONTEXT_SIZE=medium    # low | medium | high — more context, more tokens
SEARCH_USER_COUNTRY=ES        # biases results; blank to disable

# Only used when SEARCH_PROVIDER=tavily / brave
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Cover images
# ---------------------------------------------------------------------------
COVER_ENABLED=true
# foundry = models deployed on your Azure resource (default; auto-detects
#           whether the model speaks MAI or the OpenAI images API)
# mai     = force the MAI route
# openai  = api.openai.com directly, using OPENAI_API_KEY below
COVER_PROVIDER=foundry
# Deployment name. Run `ppn models` to see what you have.
#   MAI-Image-2.5-Pro   Microsoft's own image model — the default here
#   gpt-image-2         GA, no registration needed
#   gpt-image-1 / -1.5 / -1-mini   limited access, must be approved first
#   dall-e-3            RETIRED March 2026, existing deployments are dead
#   FLUX-1.1-pro        Black Forest Labs, serverless everywhere, no registration
COVER_MODEL=MAI-Image-2.5-Pro
# MAI caps images at 1,048,576 total pixels (768px minimum edge). A larger value
# is fitted down automatically, keeping the aspect ratio: 1536x1024 -> 1248x832.
COVER_SIZE=1536x1024
# Ignored by MAI and FLUX; used by the gpt-image models.
COVER_QUALITY=high
COVER_API_VERSION=preview
# Leave blank to derive the resource root from FOUNDRY_PROJECT_ENDPOINT.
# Set it if images live on a different resource, e.g. https://my-aoai.openai.azure.com
COVER_ENDPOINT=
# Leave blank to authenticate with Entra (az login / managed identity).
COVER_API_KEY=

# Only used when COVER_PROVIDER=openai.
# NOTE: an OpenAI API key is NOT a ChatGPT Plus/Pro subscription. The API is a
# separate product with its own billing, and the GPT Image models additionally
# require Organization Verification at
# platform.openai.com -> Settings -> Organization -> General.
OPENAI_API_KEY=
OPENAI_ORG_ID=
# Upload the finished cover to the media library and set it as featured image.
COVER_UPLOAD_TO_WP=true

# ---------------------------------------------------------------------------
# Translation (English draft -> Spanish)
# ---------------------------------------------------------------------------
# Opt-in per draft. Leave false and decide case by case with `--translate` on
# `ppn write`, or `ppn translate drafts/<post>.md` after the fact. Set true only
# if you want EVERY approved draft translated automatically.
TRANSLATE_ENABLED=false
# Push the translated version to WordPress as its own draft post.
TRANSLATE_PUSH=true
# Never translate a draft the validators rejected.
TRANSLATE_ONLY_WHEN_APPROVED=true

# ---------------------------------------------------------------------------
# Runtime knobs
# ---------------------------------------------------------------------------
PPN_MAX_REVISION_ROUNDS=3
PPN_MAX_SOURCE_ROUNDS=2

# Wall-clock ceilings. Deliberately generous — these exist to break a genuine
# hang, not to cut short honest work. Topic discovery really does take 10-20
# minutes; a full post with both loops can take an hour.
PPN_SUGGEST_TIMEOUT_MINUTES=40
PPN_WRITE_TIMEOUT_MINUTES=90
PPN_OUTPUT_DIR=drafts
PPN_RESEARCH_DIR=research
PPN_TOPICS_DIR=topics
PPN_LOG_LEVEL=INFO
