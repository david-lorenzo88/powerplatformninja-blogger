# Generated crew output — unpublished drafts and full research dossiers.
# Public repo: keep these local. .gitkeep preserves the directories.
drafts/*
!drafts/.gitkeep
research/*
!research/.gitkeep
topics/*
!topics/.gitkeep

# Author notes are per-post, personal, and may name a real tenant — keep local.
input/notes/*
!input/notes/.gitkeep
